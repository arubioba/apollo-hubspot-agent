PORT=3000
# development | test | staging | production
NODE_ENV=development

# PostgreSQL connection string. Secret; configure per environment.
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>

# Provider credentials. Secrets; never commit real values.
APOLLO_API_KEY=
HUBSPOT_PRIVATE_APP_TOKEN=
# HUBSPOT_ACCESS_TOKEN= can be used instead for compatibility.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Temporary internal admin auth and legacy high-volume approval code. Secrets.
ARA_ADMIN_TOKEN=
APPROVAL_CODE=

# Internal MVP tenant. Future tenant onboarding will replace this with per-request context.
ARA_DEFAULT_TENANT_ID=freelan

# disabled blocks HubSpot writes. preview returns planned writes. enabled preserves current write behavior.
ARA_WRITE_MODE=disabled

# External service intent for new environments. Connector Extraction will implement runtime switching.
ARA_EXTERNAL_SERVICES_MODE=mock

# Diagnostics are technical debugging endpoints, not the commercial ARA console.
ARA_DIAGNOSTICS_ENABLED=false

# Temporary local in-memory rate limiting for ARA 0.1.
ARA_RATE_LIMIT_ENABLED=true
ARA_RATE_LIMIT_WINDOW_MS=60000
ARA_RATE_LIMIT_MAX_REQUESTS=60

# Max JSON body size for POST /api/* endpoints that expect application/json.
ARA_MAX_BODY_BYTES=262144

# debug | info | warn | error
LOG_LEVEL=info

TZ=America/Mexico_City
DAILY_IMPORT_LIMIT=50
TEST_BATCH_SIZE=5
APOLLO_API_BASE=https://api.apollo.io/api/v1
HUBSPOT_API_BASE=https://api.hubapi.com
